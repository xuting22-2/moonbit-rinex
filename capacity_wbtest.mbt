  c.feed_line("> 2026 09 23 00 02 27.0000000  0  1")
  c.feed_line("G01  20000000.000 7    123456.00017")
  c.feed_line("> 2026 09 23 00 02 28.0000000  0  1")
  c.feed_line("G01  20000000.000 7    123456.00017")
  c.feed_line("> 2026 09 23 00 02 29.0000000  0  1")
  c.feed_line("G01  20000000.000 7    123456.00017")
  let report = c.finish()
  assert_eq(report.findings.length(), 128)
  assert_true(report.omitted_findings > 100)
  assert_eq(report.finding_counts.get("epoch-interval"), Some(149))
  assert_eq(report.finding_counts.get("profile-lattice"), Some(145))
}

///|
test "incomplete type continuation and capacity poison the checker" {
  let c = Checker::new()
  c.bytes = 536870912
  assert_true(
    try {
      c.feed_line("x")
      false
    } catch {
      Rejected(code, _, _) => code == "capacity"
    },
  )
  assert_true(c.closed)
  let h = Checker::new()
  h.line = 4096
  assert_true(
    try {
      h.feed_line(fixture()[0])
      false
    } catch {
      Rejected(code, _, _) => code == "capacity"
    },
  )
  let e = Checker::new()
  for line in fixture()[0:7] {
    e.feed_line(line)
  }
  e.epochs = 1000000
  assert_true(
    try {
      e.feed_line(fixture()[7])
      false
    } catch {
      Rejected(code, _, _) => code == "capacity"
    },
  )
  let records = Checker::new()
  for line in fixture()[0:8] {
    records.feed_line(line)
  }
  records.records = 2000000
  assert_true(
    try {
      records.feed_line(fixture()[8])
      false
    } catch {
      Rejected(code, _, _) => code == "capacity"
    },
  )
}
