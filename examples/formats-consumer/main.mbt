///|
fn main {
  let decoder = @r.CrinexDecoder::new()
  let output : Array[String] = []
  for
    line in [
      "3.0                 COMPACT RINEX FORMAT                    CRINEX VERS   / TYPE",
      "RNX2CRX ver.4.2.0                       27-Oct-26 17:03     CRINEX PROG / DATE",
      "     3.04           OBSERVATION DATA    G                   RINEX VERSION / TYPE",
      "G    3 C1C L1C D1C                                          SYS / # / OBS TYPES",
      "  2026    10    27     0     0    0.0000000     GPS         TIME OF FIRST OBS",
      "                                                            END OF HEADER",
      "> 2026 10 27 00 00  0.0000000  0  2      G01G02", "3&123456789012", "3&20000000000 3&-100500 3&0 &&17&&",
      "3&21000000000 3&-200500 3&5000 &&&&&&", "                 1                         2  3",
      "1", "1000  1000   78", "3&22000000000 3&-300500 3&7000 &&&&&&", "> 2026 10 27 00 02  0.0000000  4  1",
      "G    1 C1C                                                  SYS / # / OBS TYPES",
      "> 2026 10 27 00 03  0.0000000  0  1      G03", "", "3&22000001000 &&",
    ] {
    for row in (decoder.feed_line(line) catch { _ => abort("CRX decode") }) {
      output.push(row)
    }
  }
  let crx_report = decoder.finish() catch { _ => abort("CRX incomplete") }
  let legacy = @r.LegacyReader::new()
  let mut legacy_epochs = 0
  for
    line in [
      "     2.11           OBSERVATION DATA    M                   RINEX VERSION / TYPE",
      "SPEC TEST                                                   MARKER NAME",
      "    13    C1    L1    D1    S1    P1    P2    C2    L2    D2# / TYPES OF OBSERV",
      "          S2    C5    L5    D5                              # / TYPES OF OBSERV",
      "  2026    10    27     0     0    0.0000000     GPS         TIME OF FIRST OBS",
      "                                                            END OF HEADER",
      " 26 10 27  0  0  0.0000000  0 13G01G02G03G04G05G06G07G08G09G10G11G12-0.000000123",
      "                                G13", "  20000000.000     -100000.50017                         0.000          40.000 5",
      "        50.000 5        60.000 5        70.000 5        80.000 5        90.000 5",
      "       100.000 5       110.000 5       120.000 5", "  20000001.000     -100001.50017                         0.000          41.000 5",
      "        51.000 5        61.000 5        71.000 5        81.000 5        91.000 5",
      "       101.000 5       111.000 5       121.000 5", "  20000002.000     -100002.50017                         0.000          42.000 5",
      "        52.000 5        62.000 5        72.000 5        82.000 5        92.000 5",
      "       102.000 5       112.000 5       122.000 5", "  20000003.000     -100003.50017                         0.000          43.000 5",
      "        53.000 5        63.000 5        73.000 5        83.000 5        93.000 5",
      "       103.000 5       113.000 5       123.000 5", "  20000004.000     -100004.50017                         0.000          44.000 5",
      "        54.000 5        64.000 5        74.000 5        84.000 5        94.000 5",
      "       104.000 5       114.000 5       124.000 5", "  20000005.000     -100005.50017                         0.000          45.000 5",
      "        55.000 5        65.000 5        75.000 5        85.000 5        95.000 5",
      "       105.000 5       115.000 5       125.000 5", "  20000006.000     -100006.50017                         0.000          46.000 5",
      "        56.000 5        66.000 5        76.000 5        86.000 5        96.000 5",
      "       106.000 5       116.000 5       126.000 5", "  20000007.000     -100007.50017                         0.000          47.000 5",
      "        57.000 5        67.000 5        77.000 5        87.000 5        97.000 5",
      "       107.000 5       117.000 5       127.000 5", "  20000008.000     -100008.50017                         0.000          48.000 5",
      "        58.000 5        68.000 5        78.000 5        88.000 5        98.000 5",
      "       108.000 5       118.000 5       128.000 5", "  20000009.000     -100009.50017                         0.000          49.000 5",
      "        59.000 5        69.000 5        79.000 5        89.000 5        99.000 5",
      "       109.000 5       119.000 5       129.000 5", "  20000010.000     -100010.50017                         0.000          50.000 5",
      "        60.000 5        70.000 5        80.000 5        90.000 5       100.000 5",
      "       110.000 5       120.000 5       130.000 5", "  20000011.000     -100011.50017                         0.000          51.000 5",
      "        61.000 5        71.000 5        81.000 5        91.000 5       101.000 5",
      "       111.000 5       121.000 5       131.000 5", "  20000012.000     -100012.50017                         0.000          52.000 5",
      "        62.000 5        72.000 5        82.000 5        92.000 5       102.000 5",
      "       112.000 5       122.000 5       132.000 5", " 26 10 27  0  1  0.0000000  0 13G01G02G03G04G05G06G07G08G09G10G11G12-0.000000122",
      "                                G13", "  20000001.000     -100001.50017                         0.000          41.000 5",
      "        51.000 5        61.000 5        71.000 5        81.000 5        91.000 5",
      "       101.000 5       111.000 5       121.000 5", "  20000002.000     -100002.50017                         0.000          42.000 5",
      "        52.000 5        62.000 5        72.000 5        82.000 5        92.000 5",
      "       102.000 5       112.000 5       122.000 5", "  20000003.000     -100003.50017                         0.000          43.000 5",
      "        53.000 5        63.000 5        73.000 5        83.000 5        93.000 5",
      "       103.000 5       113.000 5       123.000 5", "  20000004.000     -100004.50017                         0.000          44.000 5",
      "        54.000 5        64.000 5        74.000 5        84.000 5        94.000 5",
      "       104.000 5       114.000 5       124.000 5", "  20000005.000     -100005.50017                         0.000          45.000 5",
      "        55.000 5        65.000 5        75.000 5        85.000 5        95.000 5",
      "       105.000 5       115.000 5       125.000 5", "  20000006.000     -100006.50017                         0.000          46.000 5",
      "        56.000 5        66.000 5        76.000 5        86.000 5        96.000 5",
      "       106.000 5       116.000 5       126.000 5", "  20000007.000     -100007.50017                         0.000          47.000 5",
      "        57.000 5        67.000 5        77.000 5        87.000 5        97.000 5",
      "       107.000 5       117.000 5       127.000 5", "  20000008.000     -100008.50017                         0.000          48.000 5",
      "        58.000 5        68.000 5        78.000 5        88.000 5        98.000 5",
      "       108.000 5       118.000 5       128.000 5", "  20000009.000     -100009.50017                         0.000          49.000 5",
      "        59.000 5        69.000 5        79.000 5        89.000 5        99.000 5",
      "       109.000 5       119.000 5       129.000 5", "  20000010.000     -100010.50017                         0.000          50.000 5",
      "        60.000 5        70.000 5        80.000 5        90.000 5       100.000 5",
      "       110.000 5       120.000 5       130.000 5", "  20000011.000     -100011.50017                         0.000          51.000 5",
      "        61.000 5        71.000 5        81.000 5        91.000 5       101.000 5",
      "       111.000 5       121.000 5       131.000 5", "  20000012.000     -100012.50017                         0.000          52.000 5",
      "        62.000 5        72.000 5        82.000 5        92.000 5       102.000 5",
      "       112.000 5       122.000 5       132.000 5", "  20000013.000     -100013.50017                         0.000          53.000 5",
      "        63.000 5        73.000 5        83.000 5        93.000 5       103.000 5",
      "       113.000 5       123.000 5       133.000 5", " 26 10 27  0  2  0.0000000  4  1",
      "     2    C1    L1                                          # / TYPES OF OBSERV",
      " 26 10 27  0  3  0.0000000  0  1G02", "  24000000.000      -12000.50028",
    ] {
    match (legacy.feed_line(line) catch { _ => abort("OBS2 decode") }) {
      Some(@r.LegacyItem::Epoch(_)) => legacy_epochs += 1
      _ => ()
    }
  }
  legacy.finish() catch {
    _ => abort("OBS2 incomplete")
  }
  let nav = @r.NavReader::new()
  let mut state : Json = Json::null()
  for
    line in [
      "     3.05           NAVIGATION DATA     MIXED               RINEX VERSION / TYPE",
      "                                                            END OF HEADER",
      "G01 2026 10 25 14 00 00 1.418138854206e-04-8.412825991400e-12 0.000000000000e+00",
      "     3.700000000000e+01-1.262187500000e+02 4.773056172525e-09 1.308299615199e+00",
      "    -6.677582859993e-06 2.114486764185e-03 4.556030035019e-06 5.153739910126e+03",
      "     5.040000000000e+04 3.166496753693e-08-1.124321027501e+00 5.587935447693e-08",
      "     9.559016049330e-01 2.889687500000e+02 1.457963556091e-01-8.493925562902e-09",
      "    -4.089455996059e-10 1.000000000000e+00 2.442000000000e+03 0.000000000000e+00",
      "     2.000000000000e+00 0.000000000000e+00-8.847564458847e-09 3.700000000000e+01",
      "     4.314000000000e+04 0.000000000000e+00 0.000000000000e+00 0.000000000000e+00",
    ] {
    if (nav.feed_line(line) catch { _ => abort("NAV decode") }) is Some(record) {
      state = (record.satellite_position(record.toe) catch {
        _ => abort("NAV state")
      }).to_json()
    }
  }
  nav.finish() catch {
    _ => abort("NAV incomplete")
  }
  let result : Json = {
    "crx_report": crx_report.to_json(),
    "decoded_lines": output.length().to_json(),
    "legacy_epochs": legacy_epochs.to_json(),
    "gps_state_at_toe": state,
  }
  println(result.stringify())
}
