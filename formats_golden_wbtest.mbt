///|
test "official CRX legacy exact rendering" {
  let d = CrinexDecoder::new()
  let output : Array[String] = []
  for line in golden_legacy_input() {
    for restored in d.feed_line(line) {
      output.push(restored)
    }
  }
  let report = d.finish()
  assert_eq(output.join("\n"), golden_legacy_output().join("\n"))
  assert_true(report.complete && report.acceptable)
}

