///|
test "official CRX modern exact rendering" {
  let d = CrinexDecoder::new()
  let output : Array[String] = []
  for line in golden_modern_input() {
    for restored in d.feed_line(line) {
      output.push(restored)
    }
  }
  let report = d.finish()
  assert_eq(output.join("\n"), golden_modern_output().join("\n"))
  assert_true(report.complete && report.acceptable)
}

///|
fn golden_nav_0() -> NavRecord raise {
  let reader = NavReader::new()
  let mut found : NavRecord? = None
  for
    line in [
      "     3.05           NAVIGATION DATA     MIXED               RINEX VERSION / TYPE",
      "                                                            END OF HEADER",
      "C01 2026 10 25 23 00 00 -.755535438657e-06 -.159872115546e-13  .000000000000e+00",
      "      .100000000000e+01 -.195656250000e+03  .235152652195e-08 -.112413542562e+01",
      "     -.655231997371e-05  .555403763428e-03  .288942828774e-04  .649335303116e+04",
      "      .828000000000e+05 -.512227416039e-08  .291598367591e+01  .196509063244e-06",
      "      .797582878300e-01 -.877046875000e+03  .406751381228e+00 -.135684223221e-08",
      "     -.564309220030e-09  .000000000000e+00  .108600000000e+04  .000000000000e+00",
      "      .200000000000e+01  .000000000000e+00  .449999992824e-08  .450000000000e-08",
      "      .828000000000e+05  .100000000000e+01                                      ",
    ] {
    if reader.feed_line(line) is Some(record) {
      found = Some(record)
    }
  }
  reader.finish()
  found.unwrap()
}

///|
test "RTKLIB BDS-GEO real broadcast states" {
  let record = golden_nav_0()
  {
    let got = record.satellite_position(
      record.toe.offset_seconds(-1800),
      bds_orbit=GEO,
    )
    let distance = ((got.x - -32274861.902279027) *
    (got.x - -32274861.902279027) +
    (got.y - 27119803.724308025) * (got.y - 27119803.724308025) +
    (got.z - 189376.42544444092) * (got.z - 189376.42544444092)).sqrt()
    assert_true(distance <= 0.00001)
    assert_true((got.clock_seconds - -7.539831650086216e-07).abs() <= 1.0e-13)
    assert_true(got.iterations >= 3 && got.iterations <= 15)
  }
  {
    let got = record.satellite_position(
      record.toe.offset_seconds(0),
      bds_orbit=GEO,
    )
    let distance = ((got.x - -32274106.719875127) *
    (got.x - -32274106.719875127) +
    (got.y - 27116138.47989116) * (got.y - 27116138.47989116) +
    (got.z - 153352.1530959378) * (got.z - 153352.1530959378)).sqrt()
    assert_true(distance <= 0.00001)
    assert_true((got.clock_seconds - -7.540900149076866e-07).abs() <= 1.0e-13)
    assert_true(got.iterations >= 3 && got.iterations <= 15)
  }
  let got = record.satellite_position(
    record.toe.offset_seconds(1800),
    bds_orbit=GEO,
  )
  let distance = ((got.x - -32273962.106001027) * (got.x - -32273962.106001027) +
  (got.y - 27111971.648870274) * (got.y - 27111971.648870274) +
  (got.z - 114680.06349122198) * (got.z - 114680.06349122198)).sqrt()
  assert_true(distance <= 0.00001)
  assert_true((got.clock_seconds - -7.542217521595711e-07).abs() <= 1.0e-13)
  assert_true(got.iterations >= 3 && got.iterations <= 15)
}

