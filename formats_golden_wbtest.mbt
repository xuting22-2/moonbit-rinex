  )
  let distance = ((got.x - -15650598.74690744) * (got.x - -15650598.74690744) +
  (got.y - -593674.95527197) * (got.y - -593674.95527197) +
  (got.z - 21452007.709426593) * (got.z - 21452007.709426593)).sqrt()
  assert_true(distance <= 0.00001)
  assert_true((got.clock_seconds - 0.00014179390078883486).abs() <= 1.0e-13)
  assert_true(got.iterations >= 3 && got.iterations <= 15)
}
